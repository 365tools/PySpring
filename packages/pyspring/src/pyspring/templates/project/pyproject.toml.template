[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "pyspring"
version = "1.1.0"
authors = [
  { name="Yingchun", email="allureyc@gmail.com" },
]
description = "A SpringBoot-style scaffold for FastAPI with IoC and Auto-Configuration."
readme = "README.md"
requires-python = ">=3.12"
classifiers = [
    "Programming Language :: Python :: 3",
    "License :: OSI Approved :: Apache Software License",
    "Operating System :: OS Independent",
]
dependencies = [
    "fastapi>=0.104.0",
    "uvicorn[standard]>=0.24.0",
    "python-multipart>=0.0.6",
    "pydantic>=2.0.0",
    "pydantic-core>=2.10.1",
    "pydantic-settings>=2.0.0",
    "pydantic[email]>=2.0.0",
    "dependency_injector>=4.42.0",
    "loguru>=0.7.0",
    "pyyaml>=6.0.0",
    "python-dotenv>=1.0.0",
    "cryptography>=41.0.0",
    "sqlalchemy>=2.0.0",
    "alembic>=1.12.0",
    "asyncpg>=0.29.0",
    "aiosqlite>=0.19.0",
    "redis>=5.0.0",
    "python-jose[cryptography]>=3.3.0",
    "passlib[bcrypt]>=1.7.4",
    "fastapi-users[sqlalchemy]>=13.0.0",
    "pytest>=9.0.2",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "pytest-asyncio>=0.21.0",
    "httpx>=0.25.0",
    "black>=23.0.0",
    "flake8>=6.0.0",
    "mypy>=1.5.0",
]

[project.urls]
"Homepage" = "https://github.com/365tools/PySpring"
"Bug Tracker" = "https://github.com/365tools/PySpring/issues"

# CLI has been moved to separate package
# Install with: pip install pyspring-cli
# [project.scripts]
# pyspring = "pyspring.cli:main"

[tool.setuptools.packages.find]
where = ["src"]
include = ["pyspring*"]

[tool.setuptools.package-data]
pyspring = [
    "templates/config/*.yaml",
    "templates/app/*.template",
    "templates/project/*.template",
    "templates/*.yaml",
    "templates/pyproject.toml.template",
    "templates/.gitignore.template",
    "templates/main.py.template"
]
