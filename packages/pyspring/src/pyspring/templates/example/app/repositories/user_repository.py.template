"""
用户仓储

展示：
1. Repository 模式
2. SQLAlchemy 集成
3. 异步数据库操作
4. DBManagerService 集成
"""
from typing import List, Optional, Dict

from sqlalchemy import select, update, delete, func

from pyspring.ioc import Component
from pyspring.log.instance import logger
from pyspring.repositories.db.manager import DBManagerService

from app.models.user import User


@Component
class UserRepository:
    """
    用户仓储
    
    使用 Repository 模式封装数据访问逻辑
    
    注意：
    - 使用 DBManagerService 进行会话管理
    - 不需要 ILifecycle（会话由框架管理）
    - 所有方法使用 async with await self.db.session()
    """
    
    def __init__(self, db_manager: DBManagerService):
        """
        Args:
            db_manager: 数据库管理服务（框架自动注入）
        """
        self.db = db_manager
        logger.info("📦 创建 UserRepository 实例")
    
    # ========================================================================
    # 查询方法
    # ========================================================================
    
    async def find_by_id(self, user_id: int) -> Optional[User]:
        """根据 ID 查找用户"""
        async with await self.db.session() as session:
            result = await session.execute(
                select(User).where(User.id == user_id)
            )
            return result.scalar_one_or_none()
    
    async def find_by_username(self, username: str) -> Optional[User]:
        """根据用户名查找用户"""
        async with await self.db.session() as session:
            result = await session.execute(
                select(User).where(User.username == username)
            )
            return result.scalar_one_or_none()
    
    async def find_by_user_id(self, user_id: str) -> Optional[User]:
        """根据系统用户ID（UUID）查找用户"""
        async with await self.db.session() as session:
            result = await session.execute(
                select(User).where(User.user_id == user_id)
            )
            return result.scalar_one_or_none()
    
    async def find_by_email(self, email: str) -> Optional[User]:
        """根据邮箱查找用户"""
        async with await self.db.session() as session:
            result = await session.execute(
                select(User).where(User.email == email)
            )
            return result.scalar_one_or_none()
    
    async def find_by_login_identifier(self, identifier: str) -> Optional[User]:
        """
        根据登录标识符查找用户
        
        支持：
        - 用户名 (username)
        - 邮箱 (email)
        - 手机号 (phone)
        
        Args:
            identifier: 登录标识符（用户名/邮箱/手机号）
        
        Returns:
            用户对象或 None
        """
        async with await self.db.session() as session:
            result = await session.execute(
                select(User).where(
                    (User.username == identifier) |
                    (User.email == identifier) |
                    (User.phone == identifier)
                )
            )
            return result.scalar_one_or_none()
    
    async def find_all(self, skip: int = 0, limit: int = 10) -> List[User]:
        """查找所有用户（分页）"""
        async with await self.db.session() as session:
            result = await session.execute(
                select(User).offset(skip).limit(limit)
            )
            return list(result.scalars().all())
    
    async def count(self) -> int:
        """统计用户总数"""
        async with await self.db.session() as session:
            result = await session.execute(
                select(func.count()).select_from(User)
            )
            return result.scalar_one()
    
    # ========================================================================
    # 修改方法
    # ========================================================================
    
    async def create(self, user_data: Dict) -> User:
        """创建用户"""
        async with await self.db.session() as session:
            user = User(**user_data)
            session.add(user)
            await session.commit()
            await session.refresh(user)
            return user
    
    async def update(self, user_id: int, update_data: Dict) -> Optional[User]:
        """更新用户"""
        async with await self.db.session() as session:
            await session.execute(
                update(User)
                .where(User.id == user_id)
                .values(**update_data)
            )
            await session.commit()
            
            # 查询更新后的用户
            result = await session.execute(
                select(User).where(User.id == user_id)
            )
            return result.scalar_one_or_none()
    
    async def delete(self, user_id: int) -> bool:
        """删除用户"""
        async with await self.db.session() as session:
            result = await session.execute(
                delete(User).where(User.id == user_id)
            )
            await session.commit()
            return result.rowcount > 0
