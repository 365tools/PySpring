"""
角色模型

演示：
1. 继承框架的 BaseRoleTable 基类
2. 自动获得所有角色字段（code、name、description、status）
3. 可扩展自定义字段
4. 如无特殊需求，可直接使用框架默认的 RoleTable

💡 提示：
- 本文件为扩展示例，展示如何自定义 Role 表
- 如不需要自定义字段，可删除此文件，框架会使用默认的 RoleTable
- 如需使用此自定义模型，需在 CustomSecurityEntityConfiguration 中替换：
  self.role_orm_model = Role
"""
from pyspring.repositories.db.models.common.define import BaseRoleTable


class Role(BaseRoleTable):
    """
    角色模型
    
    继承自框架的 BaseRoleTable，自动包含：
    - id: 主键
    - code: 角色代码（唯一，如 'admin'、'user'）
    - name: 角色名称（如 '管理员'、'普通用户'）
    - description: 角色描述
    - status: 角色状态（Boolean）
    - active/deleted: 状态标识（继承自审计字段）
    - creator/modifier: 审计字段
    - created_time/modified_time: 时间戳
    
    自定义扩展字段（示例）：
    # level = Column(Integer, default=0, comment="角色级别")
    # sort_order = Column(Integer, default=0, comment="排序顺序")
    """
    __tablename__ = "roles"  # 基础表名，实际会应用前缀（如 myapp_roles）
    
    # 如需扩展字段，在此添加：
    # from sqlalchemy import Column, Integer
    # level = Column(Integer, default=0, comment="角色级别")
    
    def __repr__(self):
        return f"<Role(id={self.id}, code='{self.code}', name='{self.name}')>"
