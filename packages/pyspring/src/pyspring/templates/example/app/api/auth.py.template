"""认证相关API端点

展示如何使用框架的认证服务（ILoginService、IRegisterService）

框架特性（v1.1.0+）：
1. 配置化登录字段
   - 在 config/security.yaml 中配置 identifier_fields
   - 支持任意自定义字段（username、email、phone、employee_id 等）
   - 无需编写自定义代码

2. 自动安全特性
   - 防时序攻击
   - 统一错误消息
   - 密码加密验证（BCrypt）

推荐做法：
- ✅ 使用配置文件定义登录字段
- ✅ 使用框架的 ILoginService
- ❌ 不需要自定义 LoginProvider（除非有特殊需求）

配置示例：
```yaml
# config/security.yaml
authentication:
  identifier_fields:
    - "username"   # 用户名
    - "email"      # 邮箱
    - "phone"      # 手机号（可选）
```

仅在以下情况需要自定义：
- 需要特殊的登录逻辑（短信验证码、OAuth2）
- 需要在登录前后添加额外的业务逻辑
- 需要自定义密码验证规则
"""
from fastapi import APIRouter, Depends, HTTPException, status
from fastapi.responses import JSONResponse
from pydantic import BaseModel, EmailStr, Field

from pyspring.core.abstracts.exceptions import AppError
from pyspring.core.ioc.context import Inject
from pyspring.web.core.response import Response
from pyspring.security.authentication.contracts.flow import ILoginService, IRegisterService
from pyspring.security.authentication.contracts.request import LoginRequest
from pyspring.security.authentication.contracts.response import UserInfo

# 导入自定义 Pydantic 模型
from app.schemas.user import CustomUser


router = APIRouter()


# ============================================================================
# 注册请求模型（扩展框架的 User 模型，添加自定义字段）
# ============================================================================

class RegisterRequest(BaseModel):
    """
    用户注册请求
    
    安全设计原则：
    - 注册需要明确的字段，不使用 identifier 模式
    - 所有必填字段都要明确指定，便于数据验证
    - 登录可以灵活（identifier），注册必须规范
    - ⚠️ **禁止用户指定角色**：防止权限提升攻击
    - 新用户默认分配 'guest' 角色
    - 其他角色（如admin、manager）需通过管理后台授予
    
    字段说明：
    - username: 用户名（必填，用于显示和登录）
    - email: 邮箱（必填，用于登录、找回密码、通知）
    - password: 密码（必填，至少6位）
    - phone: 手机号（可选，用于登录、双因素认证）
    """
    username: str = Field(..., min_length=3, max_length=50, description="用户名（3-50字符）")
    email: EmailStr = Field(..., description="邮箱地址")
    password: str = Field(..., min_length=6, max_length=128, description="密码（至少6位）")
    phone: str | None = Field(None, pattern=r"^1[3-9]\d{9}$", description="手机号（可选，11位数字）")
    
    class Config:
        json_schema_extra = {
            "example": {
                "username": "johndoe",
                "email": "john@example.com",
                "password": "password123",
                "phone": "13800138000"
            }
        }


# ============================================================================
# 认证端点（使用框架服务 + 自定义扩展）
# ============================================================================

@router.post("/login")
async def login(
    request: LoginRequest,
    login_service: ILoginService = Depends(lambda: Inject(ILoginService))
) -> JSONResponse:
    """
    用户登录（使用框架认证服务）
    
    框架特性（v1.1.0+）：
    - ✅ 配置化登录字段（config/security.yaml）
    - ✅ 自动返回 access_token 和 refresh_token
    - ✅ 防时序攻击、统一错误消息
    - ✅ 支持多种登录策略
    
    配置示例：
    ```yaml
    # config/security.yaml
    authentication:
      identifier_fields:
        - "username"   # 用户名
        - "email"      # 邮箱
        - "phone"      # 手机号（可选）
    ```
    
    请求示例：
    ```json
    {
        "identifier": "admin",  # 可以是用户名、邮箱、手机号等
        "password": "admin123"
    }
    ```
    
    identifier 支持的格式（根据配置）：
    - "admin"                 # 用户名
    - "admin@example.com"     # 邮箱
    - "13800138000"           # 手机号
    - "550e8400-e29b-41d4-..." # 用户ID
    
    响应示例：
    ```json
    {
        "success": true,
        "data": {
            "access_token": "eyJ...",
            "refresh_token": "eyJ...",
            "token_type": "bearer",
            "expires_in": 3600,
            "refresh_token_expire": 2592000,
            "message": "登录成功"
        }
    }
    ```
    """
    # 直接调用框架服务，异常会被全局处理器自动捕获：
    # - HTTPException: 返回对应状态码，不记录堆栈（业务错误）
    # - 其他异常: 记录完整堆栈，返回 500（系统错误）
    login_response = await login_service.login(request)
    
    return Response.success(
        login_response.model_dump(),
        message="登录成功"
    )


@router.post("/register")
async def register(
    request: RegisterRequest,
    register_service: IRegisterService = Depends(lambda: Inject(IRegisterService))
) -> JSONResponse:
    """
    用户注册（使用框架注册服务）
    
    框架安全特性：
    - ✅ 自动密码加密（BCrypt）
    - ✅ 邮箱/用户名唯一性验证
    - ✅ **自动分配默认角色（guest）**
    - ✅ **禁止用户指定角色（防止权限提升攻击）**
    - ✅ 事务管理（失败自动回滚）
    
    角色分配说明：
    - 新用户注册后自动分配 'guest' 角色
    - 其他角色（如 admin、manager）必须通过管理后台授予
    - 配置文件：config/security.yaml → authentication.registration.default_role
    
    请求示例：
    ```json
    {
        "username": "testuser",
        "email": "test@example.com",
        "password": "password123",
        "phone": "13800138000"
    }
    ```
    
    响应示例：
    ```json
    {
        "success": true,
        "data": {
            "user_id": "550e8400-e29b-41d4-...",
            "email": "test@example.com",
            "username": "testuser",
            "phone": "13800138000",
            "roles": ["guest"]
        },
        "message": "注册成功"
    }
    ```
    """
    # 生成 UUID
    import uuid
    user_uuid = str(uuid.uuid4())
    
    # 创建一个类似 User 的对象，包含自定义字段
    class UserWithCustomFields:
        def __init__(self):
            self.user_id = user_uuid
            self.email = request.email
            self.password = request.password
            self.username = request.username  # 自定义字段
            self.phone = request.phone  # 自定义字段
    
    # 使用自定义对象
    custom_user = UserWithCustomFields()
    
    # 构建 UserInfo（使用自定义 Pydantic 模型）
    user = CustomUser.model_validate(custom_user)
    user_info = UserInfo(user=user)
    
    # 直接调用框架服务，异常会被全局处理器自动捕获：
    # - HTTPException：返回对应状态码，不记录堆栈
    # - ValueError/业务异常：可抛出 AppError，自定义状态码
    # - 其他异常：记录完整堆栈，返回 500
    result = await register_service.register(user_info)
    
    return Response.success(
        {
            "user_id": result.user.user_id,
            "email": result.user.email,
            "username": result.user.username,  # 现在可以安全访问自定义字段
            "phone": result.user.phone,        # 现在可以安全访问自定义字段
        },
        message="注册成功"
    )


@router.post("/refresh")
async def refresh_token(
    refresh_token: str,
    login_service: ILoginService = Depends(lambda: Inject(ILoginService))
) -> JSONResponse:
    """
    刷新访问令牌（使用框架服务）
    
    当 access_token 过期时，使用 refresh_token 获取新的 access_token
    
    请求示例：
    {
        "refresh_token": "eyJ..."
    }
    
    响应示例：
    {
        "success": true,
        "data": {
            "access_token": "eyJ...",
            "token_type": "bearer",
            "expires_in": 3600
        }
    }
    """
    # 直接调用框架服务，异常由全局处理器处理
    token_response = await login_service.refresh_token(refresh_token)
    
    return Response.success(
        token_response.model_dump(),
        message="令牌刷新成功"
    )


@router.post("/logout")
async def logout(
    token: str,
    login_service: ILoginService = Depends(lambda: Inject(ILoginService))
) -> JSONResponse:
    """
    用户登出（使用框架服务）
    
    撤销令牌，使其失效
    
    请求示例：
    {
        "token": "eyJ..."
    }
    """
    # 直接调用框架服务，异常由全局处理器处理
    logout_response = await login_service.logout(token)
    
    return Response.success(
        logout_response.model_dump() if hasattr(logout_response, "model_dump") else None,
        message="登出成功"
    )
