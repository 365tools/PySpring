"""
PySpring 安全模块自定义配置示例

展示：
1. 如何自定义 SecurityEntityConfiguration（自定义用户表映射）
2. 如何自定义 IPasswordEncoder（自定义密码加密算法）
3. 如何自定义 ILoginProvider（自定义登录方式）
4. 如何集成框架的完整认证授权体系

使用场景：
- 当需要使用自定义用户表结构时
- 当需要实现特殊的认证方式（OAuth2、LDAP、短信验证码等）
- 当需要自定义密码加密算法时
- 当需要扩展框架的默认行为时

注意：
- 此文件为可选配置，如不需要自定义，可删除
- 框架提供的默认配置（DefaultRegisterService, DefaultLoginService）已满足大多数需求

最佳实践（v1.1.0b27+）：
- ✅ 推荐：直接继承父类 + @Component
- ✅ 优点：只需重写需要修改的部分，其他字段自动继承
- ✅ 机制：框架自动检测继承关系并替换父类

工作原理（继承替换机制）：
1. 扫描阶段：
   - 扫描框架包 → 发现 SecurityEntityConfiguration (@ConditionalOnMissingBean)
   - 扫描用户包 → 发现 CustomSecurityEntityConfiguration (@Component)
   - 构建类型映射 → 检测到 CustomSecurityEntityConfiguration 继承 SecurityEntityConfiguration
   - 标记替换关系 → metadata.replaces = 'security_entity_configuration'
   
2. 注册阶段：
   - 注册父类时 → 检查 replaced_by → 跳过注册
   - 注册子类时 → 正常注册 → 记录 replaces
   
3. 查询阶段：
   - 调用 get_bean(SecurityEntityConfiguration)
   - 精确查找失败（父类未注册）
   - 子类查找成功 → 返回 CustomSecurityEntityConfiguration 实例
   
优势：
- ✅ 无需手动指定 Bean 名称
- ✅ 符合 Spring Boot 最佳实践
- ✅ 支持多层继承
- ✅ 框架透明处理替换逻辑
"""
from pyspring.ioc.annotations import Component
from pyspring.security.authentication.config.entity import SecurityEntityConfiguration

# 导入自定义的用户模型
from app.models.user import User

# 可选：导入其他权限模型（如需自定义）
# from app.models.role import Role
# from app.models.permission import Permission
# from app.models.user_role import UserRole
# from app.models.role_permission import RolePermission


# ============================================================
# 方式1：自定义 SecurityEntityConfiguration（推荐）
# ============================================================

@Component  # ✅ 使用默认的 @Component，框架自动处理替换
class CustomSecurityEntityConfiguration(SecurityEntityConfiguration):
    """
    自定义安全实体配置 - 最简洁的方式
    
    使用场景：
    - 告诉框架使用我们自定义的 User 模型
    - 只需重写 user_orm_model，其他字段自动继承默认值
    
    工作原理（继承替换机制 v1.1.0b27+）：
    1. 继承 SecurityEntityConfiguration 并重写 __init__
    2. 使用 @Component - 无需指定 Bean 名称！
    3. 扫描阶段：
       - 框架扫描所有组件
       - 构建类型映射表
       - 检测继承关系：CustomSecurityEntityConfiguration 继承 SecurityEntityConfiguration
       - 标记替换：custom_security_entity_configuration 替换 security_entity_configuration
    4. 注册阶段：
       - 跳过父类注册（已被标记为 replaced_by）
       - 正常注册子类（记录 replaces）
    5. 查询阶段：
       - get_bean(SecurityEntityConfiguration)
       - 查找失败（父类未注册）→ 查找子类（issubclass 检查）
       - 返回子类实例
    
    优点：
    - ✅ 简洁：继承 + @Component，只写需要改的代码
    - ✅ 清晰：明确标记这是一个组件
    - ✅ 智能：框架自动检测继承关系并处理替换
    - ✅ 高效：容器里只有一个实例（真正的替换）
    - ✅ 可维护：框架新增字段自动继承
    - ✅ 无需手动维护 Bean 名称
    
    注意：
    - 无需指定 Bean 名称！框架会自动检测继承关系
    - 父类必须有 @ConditionalOnMissingBean（框架默认配置已提供）
    - 子类只需要普通的 @Component 即可
    """
    
    def __init__(self):
        super().__init__()  # 继承所有默认值
        
        # 只重写需要自定义的字段
        self.user_orm_model = User  # 使用自定义的 User 模型
        
        # 其他字段自动继承框架默认值：
        # - role_orm_model = RoleTable（框架默认）
        # - permission_orm_model = PermissionTable（框架默认）
        # - user_role_orm_model = UserRoleTable（框架默认）
        # - role_permission_orm_model = RolePermissionTable（框架默认）
        # 
        # 💡 提示：
        # 如无特殊需求，建议直接使用框架默认的权限表！
        # 框架默认表已包含：code、name、description、status 等字段
        # 
        # 📝 如需扩展权限表字段，参考以下步骤：
        #   1. 在 app/models/ 中定义自定义模型（已提供示例文件）
        #   2. 取消下面对应行的注释
        #   3. 导入对应的模型类（文件顶部）
        
        # 示例：使用自定义的权限模型（默认注释，按需启用）
        # self.role_orm_model = Role  # 使用自定义的 Role 模型
        # self.permission_orm_model = Permission  # 使用自定义的 Permission 模型
        # self.user_role_orm_model = UserRole  # 使用自定义的 UserRole 模型
        # self.role_permission_orm_model = RolePermission  # 使用自定义的 RolePermission 模型


