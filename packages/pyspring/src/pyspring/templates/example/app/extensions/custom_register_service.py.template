"""
自定义用户注册服务

展示：
1. 如何通过继承框架的 DefaultRegisterService 来自定义注册逻辑
2. 使用 @Component 装饰器让扫描器识别
3. 只需重写需要自定义的方法，其他逻辑自动继承

关键设计模式（v1.1.0b26+ 最佳实践）：
- ✅ 推荐：继承 DefaultRegisterService + @Component 装饰器
- ✅ 机制：父类有 @ConditionalOnMissingBean(IRegisterService)，子类自动替换
- ✅ 优点：只需重写需要修改的方法，复用框架其他逻辑
- ❌ 过时：使用 @Configuration + @Bean() 方式注册（代码冗余）

工作原理（替换机制）：
1. 框架默认实现：DefaultRegisterService + @ConditionalOnMissingBean(IRegisterService)
2. 用户继承实现：CustomRegisterService extends DefaultRegisterService
3. 框架先扫描 → 注册 DefaultRegisterService（条件组件）
4. 用户后扫描 → 发现 CustomRegisterService（带 @Component 装饰器）
5. IoC容器：检测到已注册的是条件组件 → 用户实现优先
6. 结果：容器中使用 CustomRegisterService，真正的替换

这就是 Spring Boot "约定优于配置" 的核心理念！
"""
from typing import Any

from pyspring.core.ioc.annotations import Component
from pyspring.core.log.instance import logger
from pyspring.repositories.db.manager import DBManagerService
from pyspring.security.authentication.services.register import DefaultRegisterService
from pyspring.security.authentication.config.entity import SecurityEntityConfiguration
from pyspring.security.authentication.contracts.password import IPasswordEncoder
from pyspring.security.authentication.contracts.response import UserInfo, User, Role, Permission
from fastapi import HTTPException, status
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

# 导入自定义用户模型（ORM）
from app.models.user import User as UserModel
# 导入自定义 Pydantic 模型
from app.schemas.user import CustomUser


@Component
class CustomRegisterService(DefaultRegisterService):
    """
    自定义用户注册服务（继承框架默认实现）
    
    使用 @Component 装饰器：
    - 让扫描器能够识别这个类
    - 父类 DefaultRegisterService 已有 @ConditionalOnMissingBean(IRegisterService)
    - 子类后注册，由于父类是条件组件，子类会替换父类
    
    继承的优点：
    - ✅ 复用框架逻辑：只需重写需要自定义的方法
    - ✅ 自动替换：父类条件注册，子类优先
    - ✅ 类型安全：保持与框架接口的兼容性
    
    可重写的方法：
    - register(): 完整的注册流程
    - _validate_user(): 验证用户输入
    - _create_user(): 创建用户记录
    - _assign_roles(): 分配角色
    
    无需 @Configuration + @Bean()！
    """
    
    def __init__(
        self,
        db: DBManagerService,
        component: SecurityEntityConfiguration,
        password_encoder: IPasswordEncoder
    ):
        """
        构造函数（框架自动注入依赖）
        
        Args:
            db: 数据库管理服务（框架提供）
            component: 安全实体配置（可自定义）
            password_encoder: 密码加密器（可自定义）
        """
        self.db = db
        self.component = component
        self.password_encoder = password_encoder
        logger.info("📦 创建自定义 CustomRegisterService 实例")
    
    async def register(self, request: UserInfo) -> UserInfo:
        """
        用户注册（自定义实现）
        
        扩展点：
        1. 注册前验证（邮箱格式、用户名规则等）
        2. 自定义字段处理（username, phone 等）
        3. 注册后操作（发送欢迎邮件、记录日志等）
        
        Args:
            request: 用户注册请求
            
        Returns:
            UserInfo: 注册后的用户信息（包括角色）
        """
        logger.info(f"🔐 自定义注册服务：注册用户 {request.user.email}")
        
        # 使用框架的数据库会话管理（自动处理事务）
        async with await self.db.session() as session:
            # 1. 自定义验证逻辑
            await self._validate_user(session, request.user)
            
            # 2. 创建用户（处理自定义字段）
            db_user = await self._create_user(session, request.user)
            
            # 3. 分配角色
            if request.roles:
                await self._assign_roles(session, db_user.user_id, request.roles)
            
            # 4. 提交事务
            await session.commit()
            await session.refresh(db_user)
            
            # 5. 自定义后置操作
            await self._after_register(db_user)
            
            # 6. 构建返回结果
            return await self._build_user_info(session, db_user)
    
    async def _validate_user(self, session: Any, user: User) -> None:
        """
        自定义验证逻辑
        
        扩展点：
        - identifier_fields 唯一性验证（动态配置驱动）
        - 密码强度验证
        - 黑名单检查
        
        框架最佳实践（v1.1.0+）：
        - ✅ 使用 self.component.identifier_fields 配置驱动
        - ✅ 只检查非 NULL 值的字段
        - ❌ 避免硬编码字段名（email、username等）
        """
        from sqlalchemy import select
        
        # 动态检查所有 identifier_fields 配置的字段唯一性
        for field_name in self.component.identifier_fields:
            # 检查用户模型是否有该字段
            if not hasattr(UserModel, field_name):
                continue
            
            # 检查用户请求是否提供了该字段（只检查非 NULL 值）
            field_value = getattr(user, field_name, None)
            if field_value is None or field_value == "":
                continue  # 跳过 NULL/空值，允许多个用户不填
            
            # 查询数据库检查唯一性
            field_column = getattr(UserModel, field_name)
            stmt = select(UserModel).where(field_column == field_value)
            result = await session.execute(stmt)
            if result.scalar_one_or_none():
                raise ValueError(f"{field_name} 已被使用: {field_value}")
        
        # 自定义验证：密码强度
        if len(user.password) < 6:
            raise ValueError("密码长度至少6位")
        
        logger.info(f"✅ 用户验证通过: user_id={user.user_id}")
    
    async def _create_user(self, session: Any, user: User) -> UserModel:
        """
        创建用户记录
        
        框架最佳实践（v1.1.0+）：
        - ✅ 使用动态字段映射（支持 identifier_fields 配置）
        - ✅ 自动处理可选字段（NULL 值）
        - ❌ 避免硬编码字段名
        
        处理：
        - 密码加密
        - UUID生成
        - 动态字段映射（identifier_fields + 扩展字段）
        - 默认值设置
        """
        import uuid
        
        # 加密密码
        hashed_password = self.password_encoder.encode(user.password)
        
        # 生成 UUID（如果没有提供）
        user_uuid = user.user_id if user.user_id else str(uuid.uuid4())
        
        # 动态构建用户字段（支持 identifier_fields 配置）
        user_data = {
            'user_id': user_uuid,              # 框架字段（UUID）
            'password': hashed_password,       # 框架字段
            'active': True,                    # 框架字段（激活状态）
            'deleted': False,                  # 框架字段（软删除）
            'creator': "system",               # 框架字段（审计）
        }
        
        # 动态添加 identifier_fields 和其他基本字段
        for field_name in ['first_name', 'last_name'] + self.component.identifier_fields:
            if hasattr(user, field_name):
                field_value = getattr(user, field_name, None)
                if field_value is not None:
                    user_data[field_name] = field_value
        
        # 添加自定义扩展字段（非 identifier_fields）
        for field_name in ['phone', 'address', 'avatar']:  # 示例扩展字段
            if hasattr(user, field_name):
                field_value = getattr(user, field_name, None)
                if field_value is not None:
                    user_data[field_name] = field_value
        
        # 创建用户实例
        db_user = UserModel(**user_data)
        
        session.add(db_user)
        await session.flush()  # 获取 ID
        
        logger.info(f"✅ 用户创建成功: user_id={db_user.user_id}")
        return db_user
    
    async def _assign_roles(self, session: Any, user_id: str, roles: list[Role]) -> None:
        """
        分配角色
        
        扩展点：
        - 自动创建不存在的角色
        - 角色权限验证
        - 默认角色分配
        
        Args:
            user_id: 用户UUID
            roles: 角色列表
        """
        from sqlalchemy import select

        # 通过 self.component 动态获取当前生效的 ORM 模型，
        # 与 CustomSecurityEntityConfiguration 保持完全一致（避免 RBAC 表不一致）。
        RoleModel = self.component.role_orm_model
        UserRoleModel = self.component.user_role_orm_model
        
        for role in roles:
            # 查找或创建角色
            result = await session.execute(
                select(RoleModel).where(RoleModel.code == role.code)
            )
            db_role = result.scalar_one_or_none()
            
            if not db_role:
                # 自动创建角色
                db_role = RoleModel(
                    code=role.code,
                    name=role.name,
                    description=role.description or f"{role.name}角色",
                    status=role.status if hasattr(role, 'status') else True,
                    active=True,
                    deleted=False,
                    creator="system"
                )
                session.add(db_role)
                await session.flush()
                logger.info(f"✅ 自动创建角色: {role.code}")
            
            # 分配角色
            user_role = UserRoleModel(
                user_id=user_id,
                role_code=db_role.code,
                active=True,
                deleted=False,
                creator="system"
            )
            session.add(user_role)
        
        logger.info(f"✅ 角色分配完成: {[r.code for r in roles]}")
    
    async def _after_register(self, user: User) -> None:
        """
        注册后置操作
        
        扩展点：
        - 发送欢迎邮件
        - 发送短信验证码
        - 记录注册日志
        - 同步到其他系统
        - 触发业务事件
        """
        logger.info(f"📧 发送欢迎邮件到: {user.email}")
        # TODO: 集成邮件服务
        # await email_service.send_welcome(user.email)
        
        logger.info(f"📊 记录注册事件: 用户 {user.username} 注册成功")
        # TODO: 记录到审计日志
        # await audit_service.log_register(user.id)
    
    async def _build_user_info(self, session: Any, user: User) -> UserInfo:
        """
        构建返回的用户信息
        
        包含：
        - 用户基本信息
        - 角色列表
        - 自定义字段
        """
        from sqlalchemy import select

        # 通过 self.component 动态获取当前生效的 ORM 模型（与 CustomSecurityEntityConfiguration 一致）
        RoleModel = self.component.role_orm_model
        UserRoleModel = self.component.user_role_orm_model
        
        # 查询用户角色
        result = await session.execute(
            select(RoleModel)
            .join(UserRoleModel, UserRoleModel.role_code == RoleModel.code)
            .where(UserRoleModel.user_id == user.user_id)
        )
        db_roles = result.scalars().all()
        
        # 构建返回对象（使用自定义 Pydantic 模型）
        logger.info(f"✅ 用户信息构建完成")
        return UserInfo(
            user=CustomUser(
                id=user.id,
                user_id=user.user_id,
                email=user.email,
                username=user.username,    # 自定义字段
                phone=user.phone,          # 自定义字段
                active=user.active,        # 框架字段（已统一为 active）
            ),
            roles=[
                Role(
                    id=r.id,
                    code=r.code,
                    name=r.name,
                    description=r.description,
                    status=r.status
                )
                for r in db_roles
            ]
        )
