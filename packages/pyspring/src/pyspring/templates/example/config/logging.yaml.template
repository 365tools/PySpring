# 日志系统配置示例
# 复制此文件为 logging.yaml 并根据需要修改

# 基本配置
logging:
  # 应用日志级别（控制 Loguru 日志输出）
  # 注意：这与 application.yaml 中的 server.log_level 不同
  # - logging.level: 控制应用内部代码的日志级别（本配置）
  # - server.log_level: 控制 Uvicorn 服务器的日志输出
  # 日志级别选项: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
  # 开发环境建议: DEBUG
  # 生产环境建议: INFO 或 WARNING
  level: "DEBUG"
  
  # 控制台日志配置
  console:
    enabled: true
    colorize: true  # 生产环境可设置为 false
    # 可选格式：
    # 简洁格式: "<green>{time:HH:mm:ss}</green> | <level>{level}</level> | {message}"
    # 相对路径（推荐，IDEA完美支持跳转）: 'File "{extra[file_relative]}", line {line}'
    # 绝对路径版本: 'File "{file.path}", line {line}'
    format: "<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>File \"{extra[file_relative]}\", line {line}</cyan> | {message}"

  # 文件日志配置
  file:
    enabled: false  # 生产环境建议设置为 true
    path: "logs/app.log"
    # 轮转选项:
    # - 按大小: "10 MB", "500 MB", "1 GB"
    # - 按时间: "12:00", "1 week", "1 month"
    rotation: "10 MB"
    # 保留时间: "1 day", "1 week", "1 month", "3 months"
    retention: "7 days"
    compression: "zip"  # zip, gz, tar
    format: "{time:YYYY-MM-DD HH:mm:ss.SSS} | {level: <8} | File \"{extra[file_relative]}\", line {line} | {message}"

  # 高级配置
  advanced:
    backtrace: true  # 异常时显示完整调用栈，开发环境建议 true
    diagnose: true   # 显示变量值，生产环境建议 false（安全考虑）
    enqueue: true    # 异步日志，提高性能
    depth_offset: 1  # 通常不需要修改

  # 过滤器配置
  filters:
    health_check: true
    metrics: true
    favicon: true
    # 添加需要过滤的自定义路径
    custom_paths:
      - "/health"
      - "/metrics"
      - "/favicon.ico"
      # - "/api/internal"  # 添加您的路径

  # HTTP 请求/响应详细日志配置（开发调试利器）
  http:
    # ⚠️  生产环境建议全部设置为 false，避免日志过多和性能问题
    # 是否启用详细请求日志（包含headers和body）
    log_request_details: true   # 开发环境: true, 生产环境: false
    # 是否启用详细响应日志（包含响应体）
    log_response_details: true  # 开发环境: true, 生产环境: false
    # 是否记录请求头（会过滤敏感字段）
    log_request_headers: true   # 开发环境: true, 生产环境: false
    # 是否记录请求体（⚠️  可能包含密码等敏感信息）
    log_request_body: true      # 开发环境: true, 生产环境: false
    # 是否记录响应体（⚠️  可能很大，影响性能）
    log_response_body: true     # 开发环境: true, 生产环境: false
    # 请求/响应体最大记录长度（字节）
    max_body_length: 2048       # 开发环境: 2048, 生产环境: 512
    # 敏感请求头（这些字段会被替换为 ***）
    sensitive_headers:
      - "authorization"
      - "cookie"
      - "x-api-key"
      - "x-auth-token"
      - "x-csrf-token"

  # 日志拦截配置
  intercept:
    stdlib: true
    uvicorn: true
    fastapi: true
    watchfiles: true
    # 添加需要拦截的自定义日志记录器
    custom_loggers:
      - "sqlalchemy.engine"  # 拦截 SQLAlchemy SQL 日志
      - "asyncio"
      # - "httpx"  # 拦截 HTTPX 请求日志
      # - "redis"  # 拦截 Redis 日志

# 环境配置示例：
# 开发环境：
#   level: "DEBUG"
#   console.colorize: true
#   file.enabled: false
#   advanced.diagnose: true

# 生产环境：
#   level: "INFO"
#   console.colorize: false
#   file.enabled: true
#   file.rotation: "500 MB"
#   file.retention: "30 days"
#   advanced.diagnose: false
