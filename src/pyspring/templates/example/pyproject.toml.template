[project]
name = "pyspring-example"
version = "1.0.0"
description = "PySpring Framework Example Project"
authors = [
    { name = "Your Name", email = "your.email@example.com" }
]
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }

dependencies = [
    # ============================================================================
    # 核心框架
    # ============================================================================
    "pyspring",  # 自动使用最新版本
    
    # ============================================================================
    # Web 框架
    # ============================================================================
    "fastapi>=0.104.0",
    "uvicorn[standard]>=0.24.0",
    "python-multipart>=0.0.6",
    
    # ============================================================================
    # 数据库
    # ============================================================================
    "sqlalchemy>=2.0.0",
    "aiosqlite>=0.19.0",  # SQLite 异步驱动
    
    # ============================================================================
    # 缓存
    # ============================================================================
    "redis>=5.0.0",  # Redis 客户端（可选）
    
    # ============================================================================
    # 认证
    # ============================================================================
    "pyjwt>=2.8.0",  # JWT 令牌
    "passlib[bcrypt]>=1.7.4",  # 密码哈希
    
    # ============================================================================
    # 配置管理
    # ============================================================================
    "pydantic>=2.0.0",
    "pydantic-settings>=2.0.0",
    "python-dotenv>=1.0.0",
    
    # ============================================================================
    # 日志
    # ============================================================================
    "loguru>=0.7.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "pytest-asyncio>=0.21.0",
    "httpx>=0.25.0",  # 用于测试 API
    "ruff>=0.1.0",  # 代码检查和格式化
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.uv]
dev-dependencies = [
    "pytest>=7.4.0",
    "pytest-asyncio>=0.21.0",
    "httpx>=0.25.0",
]

[tool.ruff]
line-length = 120
target-version = "py310"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W"]
ignore = ["E501"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
