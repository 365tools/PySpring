# PySpring 用户项目配置 - 数据库配置
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ✅ 此文件由用户维护，可自由编辑
# 🔄 此文件中的配置会覆盖框架默认值（src/pyspring/config/defaults/database.yaml）
# 💡 只需配置您要覆盖的值，未配置的项将使用框架默认值
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 示例：使用 PostgreSQL（覆盖框架默认的 auto）
database:
  type: "postgresql"
  
  postgresql:
    host: "localhost"
    port: 5432
    database: "my_app"
    user: "postgres"
    # 生产环境通过环境变量设置密码
    # password: ${POSTGRES_PASSWORD}

# 数据库表结构初始化配置（开发环境建议启用）
initialization:
  # 启用自动创建表
  enabled: true
  # 增量模式：只创建不存在的表
  mode: "incremental"
  # 使用 SQLAlchemy 自动建表（不使用 SQL 脚本）
  script_path: null

# 示例：使用 SQLite（开发环境）
# database:
#   type: "sqlite"
#   sqlite:
#     path: "data/my_app.db"

# 示例：覆盖缓存配置
