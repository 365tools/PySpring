"""
权限模型

演示：
1. 继承框架的 BasePermissionTable 基类
2. 自动获得所有权限字段（code、name、description、status）
3. 可扩展自定义字段
4. 如无特殊需求，可直接使用框架默认的 PermissionTable

💡 提示：
- 本文件为扩展示例，展示如何自定义 Permission 表
- 如不需要自定义字段，可删除此文件，框架会使用默认的 PermissionTable
- 如需使用此自定义模型，需在 CustomSecurityEntityConfiguration 中替换：
  self.permission_orm_model = Permission
"""
from pyspring.repositories.db.models.common.define import BasePermissionTable


class Permission(BasePermissionTable):
    """
    权限模型
    
    继承自框架的 BasePermissionTable，自动包含：
    - id: 主键
    - code: 权限代码（唯一，如 'users:read'、'articles:write'）
    - name: 权限名称（如 '查看用户'、'编辑文章'）
    - description: 权限描述
    - status: 权限状态（Boolean）
    - active/deleted: 状态标识（继承自审计字段）
    - creator/modifier: 审计字段
    - created_time/modified_time: 时间戳
    
    权限代码规范：
    - 格式：resource:action（如 'users:read'、'orders:delete'）
    - resource: 资源类型（users、orders、articles 等）
    - action: 操作类型（read、write、delete、approve 等）
    
    自定义扩展字段（示例）：
    # resource = Column(String(100), comment="资源类型")
    # action = Column(String(50), comment="操作类型")
    # category = Column(String(50), comment="权限分类")
    """
    __tablename__ = "permissions"  # 基础表名，实际会应用前缀（如 myapp_permissions）
    
    # 如需扩展字段，在此添加：
    # from sqlalchemy import Column, String
    # resource = Column(String(100), comment="资源类型")
    # action = Column(String(50), comment="操作类型")
    
    def __repr__(self):
        return f"<Permission(id={self.id}, code='{self.code}', name='{self.name}')>"
