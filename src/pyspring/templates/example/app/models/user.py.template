"""
用户模型

演示：
1. 继承框架的 BaseUserTable 基类
2. 自动获得鉴权授权所需的所有字段
3. 可扩展自定义字段
4. 表名会自动应用项目前缀（repositories.yaml 中配置 table_prefix）
"""
from sqlalchemy import Column, String

from pyspring.repositories.db.models.common.define import BaseUserTable


class User(BaseUserTable):
    """
    用户模型
    
    继承自框架的 BaseUserTable，自动包含：
    - id: 主键
    - user_id: 用户ID（系统内部UUID，自动生成）
    - email: 邮箱（可用于登录）
    - password: 密码哈希
    - first_name/last_name: 姓名
    - uuid: UUID
    - active/deleted: 状态标识
    - creator/modifier: 审计字段
    - created_time/modified_time: 时间戳
    
    自定义扩展字段：
    - username: 用户名/昵称（可用于登录）
    - phone: 手机号
    """
    __tablename__ = "users"  # 基础表名，实际会应用前缀（如 myapp_users）
    
    # 自定义字段
    username = Column(String(50), unique=True, index=True, nullable=False, comment="用户名/昵称（用于登录）")
    phone = Column(String(20), nullable=True, comment="手机号")
    
    def __repr__(self):
        return f"<User(id={self.id}, username='{self.username}', email='{self.email}')>"
