"""
文章模型（业务自定义表）

演示：
1. 使用框架的 Base 创建自定义表
2. 建立与用户的外键关系
3. 表名会自动应用项目前缀
"""
from sqlalchemy import Column, String, Text, Integer, DateTime
from datetime import datetime, UTC

from pyspring.repositories.db.models.common.define import Base


class Article(Base):
    """
    文章表（业务自定义）
    
    继承自框架的 Base，包含以下基础字段：
    - active: 是否激活
    - deleted: 是否删除
    - creator/modifier: 创建/修改人
    - created_time/modified_time: 创建/修改时间
    
    自定义字段：
    - title: 标题
    - content: 内容
    - author_id: 作者ID（外键）
    - status: 状态
    - published_at: 发布时间
    """
    __tablename__ = "articles"  # 基础表名，会自动应用前缀（如 myapp_articles）
    
    id = Column(Integer, primary_key=True, autoincrement=True)
    title = Column(String(200), nullable=False, comment="标题")
    content = Column(Text, nullable=True, comment="内容")
    author_id = Column(String(36), nullable=False, comment="作者UUID")
    status = Column(String(20), default='draft', comment="状态: draft/published/archived")
    published_at = Column(DateTime, nullable=True, comment="发布时间")
