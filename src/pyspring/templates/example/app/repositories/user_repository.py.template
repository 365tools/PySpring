"""
用户仓储

展示：
1. Repository 模式
2. SQLAlchemy 集成
3. 异步数据库操作
"""
from typing import List, Optional, Dict

from sqlalchemy import select, update, delete, func
from sqlalchemy.ext.asyncio import AsyncSession

from pyspring.ioc import Component
from pyspring.ioc.interfaces import ILifecycle
from pyspring.log.instance import logger

from app.models.user import User
from app.database.session import get_db_session


@Component()
class UserRepository(ILifecycle):
    """
    用户仓储
    
    使用 Repository 模式封装数据访问逻辑
    """
    
    def __init__(self):
        self.db: Optional[AsyncSession] = None
        logger.info("📦 创建 UserRepository 实例")
    
    # ========================================================================
    # 生命周期方法
    # ========================================================================
    
    async def on_startup(self) -> None:
        """启动时初始化数据库会话"""
        logger.info("🚀 UserRepository 启动初始化...")
        
        # 获取数据库会话
        async for session in get_db_session():
            self.db = session
            break
        
        logger.info("✅ UserRepository 启动初始化完成")
    
    async def on_shutdown(self) -> None:
        """关闭时清理资源"""
        logger.info("👋 UserRepository 关闭处理...")
        
        if self.db:
            await self.db.close()
            logger.info("✅ 数据库会话已关闭")
        
        logger.info("✅ UserRepository 关闭处理完成")
    
    # ========================================================================
    # 查询方法
    # ========================================================================
    
    async def find_by_id(self, user_id: int) -> Optional[User]:
        """根据 ID 查找用户"""
        if not self.db:
            return None
        
        result = await self.db.execute(
            select(User).where(User.id == user_id)
        )
        return result.scalar_one_or_none()
    
    async def find_by_username(self, username: str) -> Optional[User]:
        """根据用户名查找用户"""
        if not self.db:
            return None
        
        result = await self.db.execute(
            select(User).where(User.username == username)
        )
        return result.scalar_one_or_none()
    
    async def find_by_email(self, email: str) -> Optional[User]:
        """根据邮箱查找用户"""
        if not self.db:
            return None
        
        result = await self.db.execute(
            select(User).where(User.email == email)
        )
        return result.scalar_one_or_none()
    
    async def find_all(self, skip: int = 0, limit: int = 10) -> List[User]:
        """查找所有用户（分页）"""
        if not self.db:
            return []
        
        result = await self.db.execute(
            select(User).offset(skip).limit(limit)
        )
        return list(result.scalars().all())
    
    async def count(self) -> int:
        """统计用户总数"""
        if not self.db:
            return 0
        
        result = await self.db.execute(
            select(func.count()).select_from(User)
        )
        return result.scalar_one()
    
    # ========================================================================
    # 修改方法
    # ========================================================================
    
    async def create(self, user_data: Dict) -> User:
        """创建用户"""
        if not self.db:
            raise RuntimeError("数据库会话未初始化")
        
        user = User(**user_data)
        self.db.add(user)
        await self.db.commit()
        await self.db.refresh(user)
        
        return user
    
    async def update(self, user_id: int, update_data: Dict) -> Optional[User]:
        """更新用户"""
        if not self.db:
            return None
        
        await self.db.execute(
            update(User)
            .where(User.id == user_id)
            .values(**update_data)
        )
        await self.db.commit()
        
        return await self.find_by_id(user_id)
    
    async def delete(self, user_id: int) -> bool:
        """删除用户"""
        if not self.db:
            return False
        
        result = await self.db.execute(
            delete(User).where(User.id == user_id)
        )
        await self.db.commit()
        
        return result.rowcount > 0
