"""
自定义用户响应模型

展示如何扩展框架的基础模型来支持项目特定的自定义字段。
"""
from typing import Optional
from pydantic import Field
from pyspring.security.authentication.contracts.response import User as BaseUser


class CustomUser(BaseUser):
    """
    自定义用户模型（扩展框架基础模型）
    
    继承框架的 User 模型，添加项目特定的自定义字段：
    - username: 用户名
    - phone: 手机号
    
    框架基础字段（继承自 BaseUser）：
    - id: 数据库主键
    - user_id: 用户UUID
    - email: 邮箱
    - first_name/last_name: 姓名
    - active: 激活状态
    """
    username: Optional[str] = Field(default=None, description="用户名")
    phone: Optional[str] = Field(default=None, description="手机号")
