"""认证相关API端点

展示如何使用框架的认证服务（ILoginService、IRegisterService）

框架特性（v1.1.0+）：
1. 配置化登录字段
   - 在 config/security.yaml 中配置 identifier_fields
   - 支持任意自定义字段（username、email、phone、employee_id 等）
   - 无需编写自定义代码

2. 自动安全特性
   - 防时序攻击
   - 统一错误消息
   - 密码加密验证（Argon2/BCrypt）

推荐做法：
- ✅ 使用配置文件定义登录字段
- ✅ 使用框架的 ILoginService
- ❌ 不需要自定义 LoginProvider（除非有特殊需求）

配置示例：
```yaml
# config/security.yaml
authentication:
  identifier_fields:
    - "username"   # 用户名
    - "email"      # 邮箱
    - "phone"      # 手机号（可选）
```

仅在以下情况需要自定义：
- 需要特殊的登录逻辑（短信验证码、OAuth2）
- 需要在登录前后添加额外的业务逻辑
- 需要自定义密码验证规则
"""
from fastapi import APIRouter, Depends, HTTPException, status
from fastapi.responses import JSONResponse
from pydantic import BaseModel

from pyspring.ioc import Inject
from pyspring.web.core.response import Response
from pyspring.security.authentication.contracts.flow import ILoginService, IRegisterService
from pyspring.security.authentication.contracts.request import LoginRequest
from pyspring.security.authentication.contracts.response import UserInfo, User


router = APIRouter()


# ============================================================================
# 注册请求模型（扩展框架的 User 模型，添加自定义字段）
# ============================================================================

class RegisterRequest(BaseModel):
    """注册请求（包含自定义字段）"""
    username: str  # 自定义字段
    email: str
    password: str
    phone: str | None = None  # 自定义字段


# ============================================================================
# 认证端点（使用框架服务 + 自定义扩展）
# ============================================================================

@router.post("/login")
async def login(
    request: LoginRequest,
    login_service: ILoginService = Depends(lambda: Inject(ILoginService))
) -> JSONResponse:
    """
    用户登录（使用框架认证服务）
    
    框架特性（v1.1.0+）：
    - ✅ 配置化登录字段（config/security.yaml）
    - ✅ 自动返回 access_token 和 refresh_token
    - ✅ 防时序攻击、统一错误消息
    - ✅ 支持多种登录策略
    
    配置示例：
    ```yaml
    # config/security.yaml
    authentication:
      identifier_fields:
        - "username"   # 用户名
        - "email"      # 邮箱
        - "phone"      # 手机号（可选）
    ```
    
    请求示例：
    ```json
    {
        "identifier": "admin",  # 可以是用户名、邮箱、手机号等
        "password": "admin123"
    }
    ```
    
    identifier 支持的格式（根据配置）：
    - "admin"                 # 用户名
    - "admin@example.com"     # 邮箱
    - "13800138000"           # 手机号
    - "550e8400-e29b-41d4-..." # 用户ID
    
    响应示例：
    ```json
    {
        "success": true,
        "data": {
            "access_token": "eyJ...",
            "refresh_token": "eyJ...",
            "token_type": "bearer",
            "expires_in": 3600,
            "refresh_token_expire": 2592000,
            "message": "登录成功"
        }
    }
    ```
    """
    try:
        login_response = await login_service.login(request)
        
        return Response.success(
            login_response.model_dump(),
            message="登录成功"
        )
    except HTTPException as e:
        return Response.error(e, default_status_code=e.status_code)
    except Exception as e:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=str(e)
            ),
            default_status_code=status.HTTP_500_INTERNAL_SERVER_ERROR
        )


@router.post("/register")
async def register(
    request: RegisterRequest,
    register_service: IRegisterService = Depends(lambda: Inject(IRegisterService))
) -> JSONResponse:
    """
    用户注册（使用框架注册服务 + 自定义扩展）
    
    框架特性：
    - ✅ 自动密码加密（BCrypt）
    - ✅ 邮箱/用户名唯一性验证
    - ✅ 用户角色分配
    - ✅ 事务管理（失败自动回滚）
    
    自定义扩展（CustomRegisterService）：
    - ✅ 自定义字段处理（username、phone）
    - ✅ 自定义验证规则（密码强度、黑名单检查）
    - ✅ 注册后置处理（发送欢迎邮件、短信通知）
    
    请求示例：
    {
        "username": "testuser",
        "email": "test@example.com",
        "password": "password123",
        "phone": "13800138000"
    }
    """
    try:
        # 构建用户信息（包含自定义字段）
        user_info = UserInfo(
            user=User(
                email=request.email,
                password=request.password,
                **{"username": request.username, "phone": request.phone}  # 自定义字段
            )
        )
        
        # 调用框架注册服务（会自动使用你的 CustomRegisterService）
        result = await register_service.register(user_info)
        
        return Response.success(
            {
                "user_id": result.user.user_id,
                "email": result.user.email,
                "username": getattr(result.user, "username", None),  # 自定义字段
            },
            message="注册成功"
        )
    except ValueError as e:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=str(e)
            ),
            default_status_code=status.HTTP_400_BAD_REQUEST
        )
    except Exception as e:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"注册失败: {str(e)}"
            ),
            default_status_code=status.HTTP_500_INTERNAL_SERVER_ERROR
        )


@router.post("/refresh")
async def refresh_token(
    refresh_token: str,
    login_service: ILoginService = Depends(lambda: Inject(ILoginService))
) -> JSONResponse:
    """
    刷新访问令牌（使用框架服务）
    
    当 access_token 过期时，使用 refresh_token 获取新的 access_token
    
    请求示例：
    {
        "refresh_token": "eyJ..."
    }
    
    响应示例：
    {
        "success": true,
        "data": {
            "access_token": "eyJ...",
            "token_type": "bearer",
            "expires_in": 3600
        }
    }
    """
    try:
        token_response = await login_service.refresh_token(refresh_token)
        
        return Response.success(
            token_response.model_dump(),
            message="令牌刷新成功"
        )
    except HTTPException as e:
        return Response.error(e, default_status_code=e.status_code)
    except Exception as e:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="刷新令牌无效或已过期"
            ),
            default_status_code=status.HTTP_401_UNAUTHORIZED
        )


@router.post("/logout")
async def logout(
    token: str,
    login_service: ILoginService = Depends(lambda: Inject(ILoginService))
) -> JSONResponse:
    """
    用户登出（使用框架服务）
    
    撤销令牌，使其失效
    
    请求示例：
    {
        "token": "eyJ..."
    }
    """
    try:
        logout_response = await login_service.logout(token)
        
        return Response.success(
            logout_response.model_dump() if hasattr(logout_response, "model_dump") else None,
            message="登出成功"
        )
    except Exception as e:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=str(e)
            ),
            default_status_code=status.HTTP_500_INTERNAL_SERVER_ERROR
        )
