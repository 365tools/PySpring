"""认证相关API端点"""
from typing import Dict

from fastapi import APIRouter, Depends, HTTPException, status
from fastapi.responses import JSONResponse
from pydantic import BaseModel, EmailStr

from pyspring.ioc import Inject
from pyspring.web.core.response import Response
from app.services.auth_service import AuthService
from app.models.user import User


router = APIRouter()


class LoginRequest(BaseModel):
    """登录请求"""
    username: str
    password: str


class RegisterRequest(BaseModel):
    """注册请求"""
    username: str
    email: EmailStr
    password: str


class TokenResponse(BaseModel):
    """令牌响应"""
    access_token: str
    token_type: str = "bearer"
    username: str


@router.post("/login")
async def login(
    request: LoginRequest,
    auth_service: AuthService = Depends(lambda: Inject(AuthService))
) -> JSONResponse:
    """
    用户登录
    
    验证用户凭据并返回 JWT 访问令牌
    """
    token = await auth_service.authenticate(request.username, request.password)
    
    if not token:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="用户名或密码错误"
            ),
            default_status_code=status.HTTP_401_UNAUTHORIZED
        )
    
    return Response.success(
        TokenResponse(
            access_token=token,
            username=request.username
        ),
        message="登录成功"
    )


@router.post("/register")
async def register(
    request: RegisterRequest,
    auth_service: AuthService = Depends(lambda: Inject(AuthService))
) -> JSONResponse:
    """
    用户注册
    
    创建新用户账户
    """
    try:
        user = await auth_service.register(
            username=request.username,
            email=request.email,
            password=request.password
        )
        
        return Response.success(
            {
                "id": user.id,
                "username": user.username,
                "email": user.email
            },
            message="注册成功"
        )
    except ValueError as e:
        return Response.error(
            HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=str(e)
            ),
            default_status_code=status.HTTP_400_BAD_REQUEST
        )


@router.post("/logout")
async def logout() -> JSONResponse:
    """
    用户登出
    
    注意：JWT 是无状态的，客户端应删除本地令牌
    """
    return Response.success(
        None,
        message="登出成功（请删除客户端令牌）"
    )
