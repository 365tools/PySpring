# 示例2：自定义密码加密器（推荐方式）
"""
from passlib.context import CryptContext
from pyspring.ioc.annotations import ConditionalOnMissingBean

@ConditionalOnMissingBean(IPasswordEncoder)
class CustomPasswordEncoder(IPasswordEncoder):
    '''自定义密码加密器（使用 Argon2） - 推荐方式'''
    
    def __init__(self):
        self.pwd_context = CryptContext(schemes=["argon2"], deprecated="auto")
    
    def encode(self, raw_password: str) -> str:
        return self.pwd_context.hash(raw_password)
    
    def verify(self, raw_password: str, hashed_password: str) -> bool:
        return self.pwd_context.verify(raw_password, hashed_password)

# 无需 @Configuration + @Bean()！
# 框架会自动扫描并注册此实现
# 由于 @ConditionalOnMissingBean，框架的 BCryptPasswordEncoder 会被跳过
