# 示例4：完全自定义用户表（不继承 BaseUserTable）
"""
from sqlalchemy import Column, Integer, String
from sqlalchemy.orm import declarative_base

CustomBase = declarative_base()

class CustomUser(CustomBase):
    '''完全自定义的用户表（不继承 BaseUserTable）'''
    __tablename__ = "custom_users"
    
    id = Column(Integer, primary_key=True)
    login_name = Column(String(100), unique=True, nullable=False)
    email_address = Column(String(100), unique=True, nullable=False)
