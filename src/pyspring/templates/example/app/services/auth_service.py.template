"""
认证服务 - PySpring 框架最佳实践

展示：
1. 使用框架 JWTTokenGenerator 生成和验证 Token
2. 通过依赖注入获取框架组件
3. 密码哈希和用户认证
4. 配置统一管理（config/security.yaml）

💡 扩展方式：
- 自定义 Token Payload：在 create_access_token 中添加额外字段
- 自定义验证逻辑：继承 JWTTokenGenerator 重写 encode/decode 方法
- 自定义认证提供者：实现 IAuthenticationProvider 接口
"""
from typing import Optional

import bcrypt

from pyspring.ioc import Component
from pyspring.log.instance import logger
from pyspring.security.authentication.token.generator.jwt import JWTTokenGenerator

from app.repositories.user_repository import UserRepository
from app.models.user import User


@Component
class AuthService:
    """
    认证服务 - 框架最佳实践示范
    
    核心设计：
    1. 依赖注入：通过构造函数注入 JWTTokenGenerator
    2. 配置驱动：JWT 配置由 config/security.yaml 统一管理
    3. 职责分离：AuthService 专注业务逻辑，Token 处理委托给框架组件
    
    扩展示例：
    - 添加自定义 Token 字段（roles, permissions 等）
    - 实现 Token 刷新逻辑
    - 集成多因素认证
    """
    
    def __init__(
        self, 
        user_repository: UserRepository,
        jwt_generator: JWTTokenGenerator  # 框架 JWT 组件（依赖注入）
    ):
        self.user_repository = user_repository
        self.jwt_generator = jwt_generator
        logger.info("📦 AuthService 初始化（使用框架 JWT 组件）")
    
    # ========================================================================
    # 密码处理
    # ========================================================================
    
    def hash_password(self, password: str) -> str:
        """哈希密码"""
        return bcrypt.hashpw(password.encode('utf-8'), bcrypt.gensalt()).decode('utf-8')
    
    def verify_password(self, plain_password: str, hashed_password: str) -> bool:
        """验证密码"""
        return bcrypt.checkpw(plain_password.encode('utf-8'), hashed_password.encode('utf-8'))
    
    # ========================================================================
    # JWT 令牌（框架组件）
    # ========================================================================
    
    def create_access_token(self, user_data: dict) -> str:
        """
        创建访问令牌
        
        Args:
            user_data: 用户数据（user_id 必需，username/email 可选）
        
        Returns:
            JWT Token
            
        Token 设计（符合 JWT RFC 7519 标准）：
        - sub (Subject): 用户唯一标识符（user_id UUID）- 不可变
        - username/email: 可选附加信息（便于调试和显示）
        - type: Token 类型（access/refresh）
            
        框架自动处理：
        - 添加过期时间（exp）- 由 config/security.yaml 配置
        - 添加签发时间（iat）
        - 添加 Token ID（jti）- 用于黑名单
        - Token 签名和加密（可选）
            
        扩展示例 - 添加自定义字段：
            payload = {
                "sub": user_id,  # UUID（不可变）
                "username": username,  # 便于调试
                "roles": ["admin"],  # 自定义角色
                "permissions": ["read:all"],  # 自定义权限
                "type": "access"
            }
        """
        # 构造标准 Payload（符合框架 Token 设计）
        payload = {
            "sub": user_data.get("user_id"),  # Subject: 用户唯一标识符（UUID，不可变）
            "username": user_data.get("username"),  # 可选：用户名（便于调试）
            "email": user_data.get("email"),  # 可选：邮箱（便于调试）
            "type": "access"  # Token 类型
        }
        
        # 使用框架组件生成 Token
        token = self.jwt_generator.encode(payload)
        return token
    
    def verify_token(self, token: str) -> Optional[dict]:
        """
        验证令牌
        
        Args:
            token: JWT Token
        
        Returns:
            Payload（验证成功）或 None（验证失败）
            
        框架自动处理：
        - 签名验证
        - 过期时间验证
        - Token 解密（如果启用加密）
        - 异常处理和日志记录
        """
        payload = self.jwt_generator.decode(token)
        
        if not payload:
            logger.warning("Token 验证失败")
            return None
        
        return payload
    
    # ========================================================================
    # 认证业务
    # ========================================================================
    
    async def authenticate(self, login_identifier: str, password: str) -> Optional[str]:
        """
        用户认证
        
        Args:
            login_identifier: 登录标识符（用户名/邮箱/手机号）- 用于查找用户
            password: 密码
        
        Returns:
            成功返回访问令牌（Token 中的 sub = user_id），失败返回 None
            
        登录流程：
            1. 使用 identifier 查找用户（灵活支持多种登录方式）
            2. 验证密码
            3. 生成 Token（sub = user_id UUID，不可变标识符）
            4. 后续请求通过 user_id 恢复用户身份
        """
        # 查找用户（支持用户名/邮箱/手机号）
        user = await self.user_repository.find_by_login_identifier(login_identifier)
        
        if not user:
            logger.warning(f"用户不存在: {login_identifier}")
            return None
        
        if not user.active:
            logger.warning(f"用户已禁用: {login_identifier}")
            return None
        
        # 验证密码
        if not self.verify_password(password, user.password):
            logger.warning(f"密码错误: {login_identifier}")
            return None
        
        # 创建令牌（使用框架组件）
        # 传入完整用户信息，Token payload 中 sub = user_id (UUID)
        access_token = self.create_access_token({
            "user_id": user.user_id,      # 必需：用于 Token sub 字段（不可变标识符）
            "username": user.username,    # 可选：便于调试
            "email": user.email           # 可选：便于调试
            # 💡 扩展示例：添加更多字段
            # "roles": user.roles,
            # "permissions": user.permissions
        })
        
        logger.info(f"✅ 用户认证成功: {user.username} ({login_identifier})")
        return access_token
    
    async def register(self, username: str, email: str, password: str, phone: str = None) -> User:
        """
        用户注册
        
        Args:
            username: 用户名/昵称
            email: 邮箱
            password: 密码
            phone: 手机号（可选）
        
        Returns:
            创建的用户对象
        
        Raises:
            ValueError: 用户名或邮箱已存在
        """
        # 检查用户名是否存在
        existing_user = await self.user_repository.find_by_username(username)
        if existing_user:
            raise ValueError(f"用户名已存在: {username}")
        
        # 检查邮箱是否存在
        existing_email = await self.user_repository.find_by_email(email)
        if existing_email:
            raise ValueError(f"邮箱已存在: {email}")
        
        # 创建用户
        import uuid
        user_data = {
            "user_id": str(uuid.uuid4()),  # 系统内部UUID
            "username": username,
            "email": email,
            "password": self.hash_password(password),
            "phone": phone,
            "active": True
        }
        
        user = await self.user_repository.create(user_data)
        logger.info(f"✅ 用户注册成功: {username} (UUID: {user.user_id})")
        
        return user
    
    async def get_current_user(self, token: str) -> Optional[User]:
        """
        从令牌获取当前用户
        
        Args:
            token: JWT 令牌
        
        Returns:
            用户对象，验证失败返回 None
            
        设计说明：
            - 从 Token 的 sub 字段获取 user_id (UUID)
            - 通过 user_id 查找用户（不可变、稳定）
            - sub 是 JWT 标准的用户唯一标识符字段
        """
        payload = self.verify_token(token)
        
        if not payload:
            return None
        
        # 从 sub 获取 user_id (UUID) - JWT 标准字段
        user_id = payload.get("sub")
        if not user_id:
            logger.warning("Token payload 缺少 sub 字段")
            return None
        
        # 通过 user_id 查找用户
        user = await self.user_repository.find_by_user_id(user_id)
        return user
