"""
自定义登录提供者示例

⚠️ 注意：从 v1.1.0 开始，框架已支持配置化登录字段，大多数情况下无需自定义！

推荐做法：
1. 在 config/security.yaml 中配置 identifier_fields
2. 框架会自动支持配置的字段进行登录

仅在以下情况需要自定义：
- 需要特殊的登录逻辑（如短信验证码、OAuth2）
- 需要在登录前后添加额外的业务逻辑
- 需要自定义密码验证规则

配置示例（推荐）：
```yaml
# config/security.yaml
authentication:
  identifier_fields:
    - "username"   # 用户名
    - "email"      # 邮箱
    - "phone"      # 手机号（如果用户模型有此字段）
    - "employee_id" # 员工工号（自定义字段）
```

如果确实需要自定义，参考以下示例：
"""
from typing import Any

from fastapi import HTTPException, status

from pyspring.ioc.annotations import Component
from pyspring.log.instance import logger
from pyspring.repositories.db.manager import DBManagerService
from pyspring.security.authentication.contracts.password import IPasswordEncoder
from pyspring.security.authentication.contracts.user import IUserProvider
from pyspring.security.authentication.providers.login.password import DefaultPasswordLoginProvider

from app.models.user import User


# ============================================================================
# 示例：自定义登录提供者（仅作参考，大多数情况下不需要）
# ============================================================================

# 取消注释以启用自定义登录提供者
# @Component()
class CustomPasswordLoginProvider(DefaultPasswordLoginProvider):
    """
    自定义密码登录提供者 - 示例
    
    ⚠️ 从 v1.1.0 开始，推荐使用配置文件而不是自定义代码！
    
    使用配置文件（config/security.yaml）：
    ```yaml
    authentication:
      identifier_fields:
        - "username"
        - "email"
        - "phone"
    ```
    
    仅在需要特殊逻辑时才继承此类：
    - ✅ 添加登录前后的业务逻辑
    - ✅ 自定义密码验证规则
    - ✅ 集成第三方认证服务
    
    父类已提供的特性：
    - ✅ 防时序攻击
    - ✅ 统一错误消息
    - ✅ 密码加密验证
    - ✅ 配置化字段匹配
    """

    def __init__(self, user_provider: IUserProvider, db: DBManagerService, password_encoder: IPasswordEncoder):
        super().__init__(user_provider, db, password_encoder)
        logger.info("📦 使用自定义 CustomPasswordLoginProvider")

    async def authenticate(self, request: Any) -> Any:
        """
        示例：在认证前后添加自定义逻辑
        """
        from pyspring.security.authentication.contracts.request import LoginRequest
        
        if not isinstance(request, LoginRequest):
            raise TypeError(f"CustomPasswordLoginProvider only supports LoginRequest, got {type(request)}")

        # ===== 自定义逻辑：登录前 =====
        # 例如：记录登录尝试
        logger.info(f"🔐 登录尝试: {request.identifier}")
        
        # ===== 调用父类标准认证逻辑 =====
        # 父类会自动从配置读取 identifier_fields 并匹配字段
        user = await super().authenticate(request)
        
        # ===== 自定义逻辑：登录后 =====
        # 例如：更新最后登录时间
        # await self.update_last_login(user.id)
        
        logger.info(f"✅ 登录成功: {user.username}")
        return user


__all__ = ["CustomPasswordLoginProvider"]
