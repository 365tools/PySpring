# 环境变量配置

# ============================================================================
# 应用配置
# ============================================================================
APP_NAME=PySpring 示例应用
APP_VERSION=1.0.0
DEBUG=true

# ============================================================================
# 数据库配置
# ============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 如果使用 PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# 如果使用 MySQL:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname

# ============================================================================
# Redis 配置
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# JWT 配置
# ============================================================================
# JWT 签名密钥 (必须设置强密钥)
# 生成方式: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=your-secret-key-change-in-production-12345678

# JWT 算法 (可选，默认 HS256)
JWT_ALGORITHM=HS256

# Access Token 过期时间 (秒，可选，默认 3600)
ACCESS_TOKEN_EXPIRE=3600

# Refresh Token 过期时间 (秒，可选，默认 2592000 = 30天)
REFRESH_TOKEN_EXPIRE=2592000

# JWT 加密配置 (可选)
# JWT_ENCRYPTION_ENABLED=false
# JWT_ENCRYPTION_KEY=your-encryption-key

# ============================================================================
# 日志配置
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================================================
# API 配置
# ============================================================================
API_PREFIX=/api
API_VERSION=v1
